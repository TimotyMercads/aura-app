# Copy this file to ".env" (same folder as app.py) and edit values if your
# XAMPP MySQL setup differs from a fresh default install.
#
# A brand-new XAMPP install needs NO changes here at all - these defaults
# already match it (root user, no password, port 3306).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aura_db

# Optional: change the Flask session secret for production use.
# SECRET_KEY=change-me-to-something-random
